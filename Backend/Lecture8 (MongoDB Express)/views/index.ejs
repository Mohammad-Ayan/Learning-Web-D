<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp Tutorial</title>
    <link rel="stylesheet" href="/styles.css">

</head>
<body>
    <h3>Chats</h3>
    <form method="GET" action="/chats/new">
        <button>New Chat</button>
    </form>
    <br>
    <% for (let chat of chats){ %>
        <div class="chat">
            <p>From: <%= chat.from %>
            </p>
            <div class="msg">
                <p>
                    <%= chat.msg %>
                </p>
                <form method="GET" action="/chats/<%= chat._id %>/edit">
                    <button>edit</button>
                </form>
                <br>
                 <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                    <button>delete</button>
                </form>
            </div>
            <p> Recieved By: <%= chat.to %>
            </p>
            <hr>
            <p> Sent At: <%= chat.createdAt.toLocaleString() %>
            </p>
        </div>
        <% } %>
</body>

</html>