<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post in Details</title>
     <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Here is your post details</h2>
    <p>Post id: <%= post.id %></p>
    <div class="post-details">
        <h3 class="user">@<%=post.username%></h3>
        <h4 class="content"><%=post.content%></h4>
        <p class="date">Posted on: <%= new Date().toLocaleDateString() %></p>
        
    </div>
</body>
</html>